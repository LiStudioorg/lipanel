# ============================================================
# lipanel .gitignore
# 目标：只跟踪源码与配置，忽略依赖、构建产物、本地环境与凭据。
# ============================================================

# ---------- 依赖 ----------
node_modules/
web/node_modules/
# 本地 npm 缓存（沙箱/HOME 不可写时使用）
# 用 **/ 前缀而不是 web/.npm-cache/：在 web/ 目录内执行
# `npm_config_cache=web/.npm-cache npm run build` 会生成
# web/web/.npm-cache 这种嵌套路径，只写死一层是拦不住的。
**/.npm-cache/

# ---------- 前端构建产物 ----------
# 注意：不能写成 `web/dist/`（整目录忽略），否则 web/dist/.gitkeep 无法入库，
# 会导致干净 clone 后 go:embed 报 "pattern all:web/dist: no matching files found"。
# go:embed 要求目标目录必须非空，因此这里只忽略内容、保留占位文件。
web/dist/*
!web/dist/.gitkeep

# ---------- Go 编译产物 ----------
# 统一产物名：lipanel（与仓库名一致，由 build.sh 输出到 dist/）
/lipanel
/dist/
/bin/
*.exe
*.test

# ---------- 环境变量与凭据（严禁入库） ----------
.env
.env.*
# 例外必须写在最后：Git 按顺序匹配，最后命中的规则生效。
!.env.example
*.pem
*.key
*.crt
.git-credentials

# ---------- 运行时数据与日志 ----------
*.log
logs/
# `logs/` 之上这行是为了忽略**运行日志目录**（如根目录下的 logs/ 放运行时日志）。
# 但它会连同源码目录 internal/logs/ 一起忽略掉——那是 Go 源码包，必须入库，
# 因此显式排除，避免新增的日志查看模块无法提交。
!internal/logs/
data/
tmp/
coverage.txt
*.out

# ---------- 本地端到端测试实例 ----------
# .e2e/ 是为验证网站管理（4.3）在**工作区内**起的一个真实 nginx 实例：
# 它有自己的 nginx.conf / sites-available / sites-enabled / 运行日志与 pid。
#
# 之所以需要它：开发沙箱是 workspace-write，/etc/nginx 不可写，而
# `nginx -t` 与 reload 必须打到**真实实例**上才算验证过（本阶段的硬性要求），
# 因此用 `-nginx-prefix` 指到工作区内。
#
# **绝不能入库**：含本机绝对路径、运行期 pid 与日志，且每次测试都会变。
# 需要复现时按开发计划 4.3「验证记录」的说明重建即可。
.e2e/

# ---------- 本地 Go 构建缓存（沙箱 / HOME 不可写时使用） ----------
# 与上面的 .npm-cache 同理：开发沙箱的 HOME 不可写，
# 必须把 GOCACHE / GOMODCACHE / GOTMPDIR 指到工作区内才能编译。
# **绝不能入库**：体积大且与源码无关。
.gocache/
.gomodcache/
.gotmp/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---------- 插件前端的 embed 源 ----------
# 每个内置插件的前端有两份：
#   web/plugins/plugin-assets/<id>/plugin.js            源码：Vite 原样分发，
#                                                       也是 GET /assets 提供的版本
#   internal/plugin/builtin/<id>/frontend/plugin.js     go:embed 源：编译进二进制
#
# **两份都必须入库。** 早先这里把 frontend/plugin.js 排除了（由 build.sh 拷入），
# 结果是 CI 上 45 个平台全部编译失败：
#     internal/plugin/builtin/sysinfo/plugin.go:66:12:
#     pattern frontend: no matching files found
# 原因：go:embed 的路径是相对插件源码目录解析的（不能用 ../ 跨目录），
# 它只能指向 internal/plugin/builtin/<id>/frontend；而 CI 只下载了
# web/dist，该目录在干净的 checkout 里根本不存在——被 ignore 了。
# 入库后 checkout 即可编译，无需在工作流里做额外同步。
# 一致性由 build.sh 保证：它会把源码那份同步过来，并可在 CI 里做校验。

# ---------- curl / 测试临时文件（含 token，严禁入库） ----------
ck.txt
*.cookies
*cookie*.txt

# ---------- 本地构建产物 ----------
/lipanel
/lipanel.exe
